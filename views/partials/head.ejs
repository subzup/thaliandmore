<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= meta.title %></title>
<meta name="description" content="<%= meta.description %>">
<link rel="canonical" href="<%= meta.url %>">
<meta name="robots" content="<%= typeof noIndex !== 'undefined' && noIndex ? 'noindex, nofollow' : 'index, follow' %>">
<meta name="author" content="<%= site.name %>">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content="<%= meta.title %>">
<meta property="og:description" content="<%= meta.description %>">
<meta property="og:url" content="<%= meta.url %>">
<meta property="og:site_name" content="<%= site.name %>">
<meta property="og:image" content="<%= meta.ogImage %>">
<meta property="og:locale" content="en_IN">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= meta.title %>">
<meta name="twitter:description" content="<%= meta.description %>">
<meta name="twitter:image" content="<%= meta.ogImage %>">

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/images/icons/favicon.svg">

<!-- Fonts: preconnect for performance -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Styles -->
<link rel="stylesheet" href="/css/style.css">

<!-- Schema.org: LocalBusiness / FoodEstablishment (skipped on location pages,
     which render their own more specific version instead of duplicating it) -->
<% if (typeof hideDefaultSchema === 'undefined' || !hideDefaultSchema) { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  "name": "<%= site.name %>",
  "image": "<%= meta.ogImage %>",
  "url": "<%= site.url %>",
  "telephone": "<%= site.contact.phoneHref %>",
  "servesCuisine": "Indian, Home-Style, Vegetarian, Non-Vegetarian",
  "priceRange": "₹₹",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "<%= site.kitchen.addressLine %>",
    "addressRegion": "<%= site.kitchen.addressRegion %>",
    "postalCode": "<%= site.kitchen.postalCode %>",
    "addressCountry": "<%= site.kitchen.country %>"
  },
  "areaServed": <%- JSON.stringify(site.locales) %>,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "<%= site.stats.avgRating %>",
    "reviewCount": "<%= site.stats.reviewCount %>"
  },
  "review": [
    <% siteTestimonials.forEach(function(t, i) { %>
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": <%- JSON.stringify(t.name) %> },
      "reviewRating": { "@type": "Rating", "ratingValue": <%= t.rating %>, "bestRating": 5 },
      "reviewBody": <%- JSON.stringify(t.quote) %>
    }<%= i < siteTestimonials.length - 1 ? ',' : '' %>
    <% }); %>
  ]
}
</script>
<% } %>

<!-- Schema.org: Organization (sitewide, separate from the FoodEstablishment
     listing above, since Organization/sameAs is about the business entity
     itself, not any one location's food-service details) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "<%= site.legalName %>",
  "alternateName": "<%= site.name %>",
  "url": "<%= site.url %>",
  "logo": "<%= site.url %>/images/icons/favicon.svg",
  "sameAs": <%- JSON.stringify(Object.values(site.socials)) %>
}
</script>

<!-- Schema.org: WebSite (no SearchAction, this site has no internal
     search endpoint to point one at) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "<%= site.name %>",
  "url": "<%= site.url %>"
}
</script>
