<!-- Schema.org: Menu, generated live from the same admin-managed data the
     cards below render, so it can never drift out of sync with real prices -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Menu",
  "name": "<%= site.name %> Menu",
  "hasMenuSection": [
    {
      "@type": "MenuSection",
      "name": "Mains",
      "hasMenuItem": [
        <% mains.forEach(function(item, i) { %>
        {
          "@type": "MenuItem",
          "name": <%- JSON.stringify(item.name) %><% if (item.description) { %>,
          "description": <%- JSON.stringify(item.description) %><% } %>,
          "offers": [
            <% item.variants.forEach(function(v, j) { %>
            { "@type": "Offer", "price": "<%= v.price %>", "priceCurrency": "INR"<%- item.variants.length > 1 ? ', "name": ' + JSON.stringify(v.label) : '' %> }<%= j < item.variants.length - 1 ? ',' : '' %>
            <% }); %>
          ]
        }<%= i < mains.length - 1 ? ',' : '' %>
        <% }); %>
      ]
    }<%= addons.length ? ',' : '' %>
    <% if (addons.length) { %>
    {
      "@type": "MenuSection",
      "name": "Add-Ons",
      "hasMenuItem": [
        <% addons.forEach(function(item, i) { %>
        {
          "@type": "MenuItem",
          "name": <%- JSON.stringify(item.name) %>,
          "offers": [
            <% item.variants.forEach(function(v, j) { %>
            { "@type": "Offer", "price": "<%= v.price %>", "priceCurrency": "INR"<%- item.variants.length > 1 ? ', "name": ' + JSON.stringify(v.label) : '' %> }<%= j < item.variants.length - 1 ? ',' : '' %>
            <% }); %>
          ]
        }<%= i < addons.length - 1 ? ',' : '' %>
        <% }); %>
      ]
    }
    <% } %>
  ]
}
</script>

<section class="page-hero">
  <div class="container">
    <p class="eyebrow" data-aos="fade-up"><%- include('../partials/icon', { name: 'utensils', cls: 'inline-icon' }) %> Our Menu</p>
    <h1 data-aos="fade-up">Fresh, Home-Style Meals, Made to Order</h1>
    <p class="lead" data-aos="fade-up" data-aos-delay="100">Vegetarian and non-vegetarian thalis, biryanis, and combos, cooked fresh daily in our Mahishbathan kitchen. Prices shown are per item.</p>

    <div class="menu-highlights" data-aos="fade-up" data-aos-delay="150">
      <span class="pill"><%- include('../partials/icon', { name: 'flame', cls: 'inline-icon' }) %> Cooked Fresh Daily</span>
      <span class="pill"><%- include('../partials/icon', { name: 'leaf', cls: 'inline-icon' }) %> Veg &amp; Non-Veg Options</span>
      <span class="pill"><%- include('../partials/icon', { name: 'droplet', cls: 'inline-icon' }) %> Home-Style Cooking</span>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__head" data-aos="fade-up">
      <h2>Mains</h2>
    </div>
    <div class="grid grid--2" data-aos="fade-up">
      <% mains.forEach(function(item) { %>
        <div class="food-card">
          <div class="food-card__icon">🍽️</div>
          <h3><%= item.name %></h3>
          <% if (item.description) { %><p class="food-card__desc"><%= item.description %></p><% } %>
          <% item.variants.forEach(function(v) { %>
            <div class="food-card__variant">
              <span class="food-card__variant-label"><%= v.label %></span>
              <span class="food-card__variant-price">&#8377;<%= v.price %></span>
            </div>
          <% }); %>
        </div>
      <% }); %>
    </div>

    <% if (addons.length) { %>
      <div class="section__head" style="margin-top:3rem;" data-aos="fade-up">
        <h2>Add-Ons</h2>
      </div>
      <div class="grid grid--2" data-aos="fade-up">
        <% addons.forEach(function(item) { %>
          <div class="food-card">
            <h3><%= item.name %></h3>
            <% item.variants.forEach(function(v) { %>
              <div class="food-card__variant">
                <span class="food-card__variant-label"><%= item.variants.length > 1 ? v.label : '' %></span>
                <span class="food-card__variant-price">&#8377;<%= v.price %></span>
              </div>
            <% }); %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section--tint">
  <div class="container final-cta__box glass-card" data-aos="zoom-in">
    <h2>Craving This Menu Already?</h2>
    <p>Start your 7-day trial and taste it for yourself.</p>
    <div class="hero__ctas">
      <a href="/#trial" class="btn btn--primary btn--lg">Start 7-Day Trial</a>
      <a href="/plans" class="btn btn--outline btn--lg">View Plans</a>
    </div>
  </div>
</section>
