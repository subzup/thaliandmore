<div class="container">
  <%- include('../partials/breadcrumbs', { crumbs: [{ label: 'Home', path: '/' }, { label: 'Corporate Catering' }] }) %>
</div>

<section class="page-hero" style="text-align:left; padding-bottom:1.5rem;">
  <div class="container">
    <p class="eyebrow" data-aos="fade-up"><%- include('../partials/icon', { name: 'building-2', cls: 'inline-icon' }) %> Corporate Catering &amp; Events</p>
    <h1 data-aos="fade-up">Book Office Lunches, Events &amp; Recurring Catering</h1>
    <p class="lead" data-aos="fade-up" data-aos-delay="100">From a single training-day lunch to a daily office-wide subscription, our Mahishbathan kitchen already caters for offices across Sector V. Tell us what you need below.</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container plan-detail-grid">
    <div class="glass-card" data-aos="fade-right">
      <h2 style="margin-bottom:1.5rem;">Request a Quote</h2>

      <% if (success) { %>
        <div class="alert alert--success">
          <%- include('../partials/icon', { name: 'check-circle', cls: 'inline-icon' }) %>
          Thanks! Your catering enquiry has been received. Our team will reach out shortly to confirm details.
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert--error">
          <%- include('../partials/icon', { name: 'alert-circle', cls: 'inline-icon' }) %>
          <%= error %>
        </div>
      <% } %>

      <form class="lead-form" id="corporateCateringForm" data-endpoint="/api/corporate-catering" method="POST" action="/api/corporate-catering">

        <h3 class="lead-form__section-title">Your Details</h3>
        <div class="lead-form__row">
          <label class="lead-form__label" for="cc-name">Full Name *</label>
          <input type="text" id="cc-name" name="name" placeholder="Your name" required>
        </div>
        <div class="lead-form__row lead-form__row--split">
          <input type="tel" name="phone" placeholder="Mobile Number" pattern="[6-9][0-9]{9}" maxlength="10" required aria-label="Mobile Number">
          <input type="email" name="email" placeholder="Email Address" required aria-label="Email Address">
        </div>

        <h3 class="lead-form__section-title">Event &amp; Delivery Details</h3>

        <div class="lead-form__row">
          <label class="lead-form__label" for="cc-requirement">Type of Requirement *</label>
          <select id="cc-requirement" name="requirementType" required>
            <option value="" disabled selected>Select requirement type</option>
            <% options.requirementTypes.forEach(function(t) { %><option value="<%= t %>"><%= t %></option><% }); %>
          </select>
        </div>

        <div class="lead-form__row lead-form__row--split">
          <div style="flex:1;">
            <label class="lead-form__label" for="cc-date">Event Date *</label>
            <input type="date" id="cc-date" name="eventDate" required>
          </div>
          <div style="flex:1;">
            <label class="lead-form__label" for="cc-time">Preferred Delivery Time *</label>
            <input type="time" id="cc-time" name="deliveryTime" required>
          </div>
        </div>

        <div class="lead-form__row">
          <span class="lead-form__label">Recurring Requirement? *</span>
          <div class="option-group" role="radiogroup" aria-label="Recurring Requirement">
            <% options.recurringOptions.forEach(function(opt, i) { %>
              <label class="option-pill">
                <input type="radio" name="recurring" value="<%= opt %>" <%= i === 0 ? 'checked' : '' %> required>
                <span><%= opt %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <div class="lead-form__row lead-form__row--split">
          <div style="flex:1;">
            <label class="lead-form__label" for="cc-meals">Number of Meals *</label>
            <input type="number" id="cc-meals" name="numberOfMeals" min="1" placeholder="e.g. 50" required>
          </div>
          <div style="flex:1;">
            <label class="lead-form__label" for="cc-preference">Meal Preference *</label>
            <select id="cc-preference" name="mealPreference" required>
              <option value="" disabled selected>Select preference</option>
              <% options.mealPreferences.forEach(function(p) { %><option value="<%= p %>"><%= p %></option><% }); %>
            </select>
          </div>
        </div>

        <div class="lead-form__row">
          <label class="lead-form__label" for="cc-thali">Select Thali *</label>
          <select id="cc-thali" name="thali" required>
            <option value="" disabled selected>Select a thali</option>
            <% corporateThalis.forEach(function(t) { %><option value="<%= t %>"><%= t %></option><% }); %>
          </select>
        </div>

        <div class="lead-form__row">
          <label class="lead-form__label" for="cc-cafeteria">Select Corporate Cafeteria *</label>
          <select id="cc-cafeteria" name="cafeteria" required>
            <option value="" disabled selected>Select delivery point</option>
            <% cafeterias.forEach(function(c) { %><option value="<%= c %>"><%= c %></option><% }); %>
            <option value="<%= options.otherLocationValue %>">Other Location</option>
          </select>
        </div>

        <div class="conditional-fields" id="otherLocationFields" hidden>
          <div class="lead-form__row">
            <label class="lead-form__label" for="cc-company">Company Name *</label>
            <input type="text" id="cc-company" name="companyName" placeholder="Your company name">
          </div>
          <div class="lead-form__row">
            <label class="lead-form__label" for="cc-address">Office Address *</label>
            <input type="text" id="cc-address" name="officeAddress" placeholder="Full delivery address">
          </div>
          <div class="lead-form__row">
            <label class="lead-form__label" for="cc-landmark">Landmark (Optional)</label>
            <input type="text" id="cc-landmark" name="landmark" placeholder="Nearby landmark">
          </div>
        </div>

        <div class="lead-form__row">
          <span class="lead-form__label">Additional Items</span>
          <div class="option-group">
            <% options.additionalItems.forEach(function(item) { %>
              <label class="option-pill">
                <input type="checkbox" name="additionalItems" value="<%= item %>">
                <span><%= item %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <div class="lead-form__row">
          <label class="lead-form__label" for="cc-instructions">Special Instructions</label>
          <textarea id="cc-instructions" name="specialInstructions" rows="3" placeholder="Anything else we should know?" maxlength="1000"></textarea>
        </div>

        <div class="lead-form__row">
          <label class="lead-form__label" for="cc-referral">How did you hear about us?</label>
          <select id="cc-referral" name="referralSource">
            <option value="" disabled selected>Select an option</option>
            <% options.referralSources.forEach(function(r) { %><option value="<%= r %>"><%= r %></option><% }); %>
          </select>
        </div>

        <button type="submit" class="btn btn--primary btn--block btn--lg">Submit Catering Request</button>
        <p class="lead-form__status" role="status" aria-live="polite"></p>
      </form>
    </div>

    <aside data-aos="fade-left">
      <div class="info-card" style="margin-bottom:1.25rem;">
        <h3><%- include('../partials/icon', { name: 'shield-check', cls: 'inline-icon' }) %> Why Book With Us</h3>
        <ul>
          <li><%- include('../partials/icon', { name: 'check', cls: 'inline-icon icon-sm' }) %> Already caters for offices across Sector V</li>
          <li><%- include('../partials/icon', { name: 'check', cls: 'inline-icon icon-sm' }) %> One-off events or daily recurring catering</li>
          <li><%- include('../partials/icon', { name: 'check', cls: 'inline-icon icon-sm' }) %> Hygienic, FSSAI-certified kitchen</li>
          <li><%- include('../partials/icon', { name: 'check', cls: 'inline-icon icon-sm' }) %> Flexible thali options for any budget</li>
        </ul>
      </div>

      <div class="info-card">
        <h3><%- include('../partials/icon', { name: 'message-circle', cls: 'inline-icon' }) %> Prefer to Talk First?</h3>
        <p style="margin-bottom:1rem; font-size:0.9rem;">Message us your requirements directly and we'll get back with a quote.</p>
        <a href="https://wa.me/<%= site.whatsapp.number %>" class="btn btn--primary btn--block" target="_blank" rel="noopener">
          <%- include('../partials/icon', { name: 'whatsapp', cls: 'inline-icon' }) %> Chat on WhatsApp
        </a>
        <a href="tel:<%= site.contact.phoneHref %>" class="btn btn--outline btn--block" style="margin-top:0.75rem;">
          <%- include('../partials/icon', { name: 'phone', cls: 'inline-icon' }) %> <%= site.contact.phoneDisplay %>
        </a>
      </div>
    </aside>
  </div>
</section>
